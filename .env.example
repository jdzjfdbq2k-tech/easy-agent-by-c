# 复制成 .env 再填上真实值。.env 已被 .gitignore 忽略，不会进仓库。
#
# LLM_HOST  只写域名，不要带 https:// 前缀，也不要带路径
# LLM_PATH  接口路径，OpenAI 兼容协议固定是这个
# LLM_MODEL 模型名，必须该服务商真的存在，否则接口会返回 model not found
# LLM_API_KEY 完整 key，从服务商控制台复制

LLM_HOST=api.example.com
LLM_PATH=/v1/chat/completions
LLM_MODEL=example-model
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
